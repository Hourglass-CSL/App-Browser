<div class="antialiased bg-gray-50 h-full">
<%= render "shared/dashboard_header"%>
<div id="flash-container">
  <%= render "shared/flash" %>
</div>
  <main class="p-4 md:ml-64 pt-20">

    <!-- FILTRO POR DIA -->
      <section class="flex md:flex-row flex-col mx-auto content-center items-center justify-between px-8">
        <% if params[:day].present? %>
          <p class="text-gray-700 mt-2 text-xl">
            <%= t('nav.showing_info') %>
            <strong class="text-minor capitalize">
              <% index = Date::DAYNAMES.rotate.index(params[:day]) %>
              <% day_label = I18n.t('date.day_names').rotate[index] if index %>
              <%= day_label || t('all_days') %>
            </strong>
          </p>
        <% else %>
          <p class="text-gray-700 mt-2 text-xl">
            <%= t('nav.showing_info') %> <strong class="text-main"><%= t('nav.all_days') %></strong>
          </p>
        <% end %>

      <%= turbo_frame_tag "dashboard_filters" do %>
        <%= form_with url: dashboard_index_path(locale: I18n.locale),
                      method: :get,
                      data: { turbo_frame: "_top" },
                      class: "mb-4" do %>
          <div class="flex items-center space-x-4">
            <% days_en         = Date::DAYNAMES.rotate %>
            <% days_translated = I18n.t('date.day_names').rotate %>
            <% options         = days_en.zip(days_translated) %>

            <%= label_tag :day, t('nav.select_day'), class: "font-medium" %>

            <%= select_tag :day,
                options_for_select(options.map { |en, es| [es, en] }, params[:day]),
                include_blank: t('nav.all_days'),
                class: "border text-gray-900 rounded-lg focus:ring-minor focus:border-main block",
                data: { controller: "autosubmit", action: "change->autosubmit#submit" } %>
          </div>
        <% end %>
     
            
      </section>

    <!-- MODULO DE ACTIVIDADES -->
    <section class="grid grid grid-cols-1 gap-4 mb-4 pt-4">
      <div class="bg-white rounded-lg md:col-span-2 bg-white rounded-lg shadow-lg pb-4">
        <div class="bg-minor rounded-t-lg p-2 flex justify-between items-center md:px-8 px-4">
          <h2 class="text-white font-bold text-center md:text-2xl text-xl uppercase"><%= t('nav.module_title_1') %></h2>
            <% unless current_user.reader? %>  
              <%= link_to new_activity_path do %>
                <svg class="w-8 h-8 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 7.757v8.486M7.757 12h8.486M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                </svg>
              <% end %>
            <% end %>
        </div>
        <div class="overflow-x-auto"> <% if @activities.any? %>
          <table class="w-full divide-y divide-gray-200">
            <thead class="bg-main/10 font-bold sticky top-0 ">
              <tr>
                <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase"><%= t('nav.tab_title') %></th>
                <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase"><%= t('nav.tab_times') %></th>
                <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase"><%= t('nav.tab_location') %></th>
                <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase"><%= t('nav.tab_description') %></th>
                <% unless current_user.reader? %>
                  <th class="px-6 py-3"></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @activities.each do |activity| %>
                <tr id="<%= dom_id(activity) %>">
                  <td class="px-6 py-4 capitalize hover:text-minor"><%= link_to activity.title, activity_path(activity, locale: I18n.locale) %> / <%= link_to activity.nombre, activity_path(activity, locale: I18n.locale) %></td>
                  <td class="px-6 py-4 text-sm"><%= activity.open_time.strftime("%I:%M %p") %> - <%= activity.closed_time.strftime("%I:%M %p") %></td>
                  <td class="px-6 py-4 capitalize"><%= activity.location %> / <%= activity.ubicacion %></td>
                  <td class="px-6 py-4 capitalizeflex flex-col"><p class="truncate"><%= truncate(activity.description, length: 25) %></p> <p class="truncate"><%= truncate(activity.descripcion, length: 25) %></p></td>
                  <% unless current_user.reader? %>
                    <td class="px-6 py-4">
                      <span class="flex items-center justify-end space-x-6">
                        <%= link_to edit_activity_path(activity, locale: I18n.locale), title: "Edit Activity" do %>
                          <svg class="w-6 h-6 text-gray-400 hover:text-success" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/>
                          </svg>
                        <% end %>
                        <%= button_to activity_path(activity, locale: I18n.locale),
                            method: :delete,
                            data: { turbo_confirm: "Really delete this activity?" },
                            class: "inline-flex items-center px-2 py-1 cursor-pointer" do %>
                            <svg class="w-6 h-6 text-gray-400 hover:text-warning" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/>
                            </svg>
                        <% end %>
                      </span>
                    </td>
                  <% end %>
                </tr>
              <% end %>
              <% else %>
                <p class="text-center my-8"><%= t('empty') %>.</p>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

 
