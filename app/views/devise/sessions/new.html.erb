<main class="min-h-svh bg-main grid place-items-center">
  <div class="container px-6">

    <div class="grid items-center gap-16 md:grid-cols-2">
      <div class="text-center">
        <a href="<%= root_path %>" class="inline-flex items-center">
          <%= inline_svg_tag "hourglass_logo.svg",
                class: "h-20 w-24 fill-white",
                aria: { label: "Hourglass Logo" } %>
        </a>
        <h1 class="font-bold md:text-6xl text-3xl text-white md:pt-8">Hola</h1>
        <h2 class="font-bold md:text-7xl text-5xl text-white">¡BIENVENIDO!</h2>
        <p class="md:text-xl text-ds-text pt-4">Ingresa con tu usuario.</p>
      </div>

   
      <div class="md:w-1/2">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name),
                     html: { class: "mx-auto w-full max-w-md" }) do |f| %>
          <div class="space-y-4">
            <div>
              <%= f.label :email, class: "block text-sm font-medium text-white mb-1" %>
              <%= f.email_field :email,
                    autofocus: true,
                    autocomplete: "email",
                    class: "w-full rounded-lg border-gray-300 focus:border-main focus:ring-main text-gray-900 px-3 py-2 bg-white" %>
            </div>
            <div class="mb-4" data-controller="password-visibility">
              <label for="password" class="block text-sm font-medium text-white mb-1">
                 Password:
              </label>
              <div class="relative">
                <%= f.password_field :password,
                      id: "password",
                      class: "w-full rounded-lg border-gray-300 focus:border-main focus:ring-main text-gray-900 px-3 py-2 bg-white",
                      data: { "password-visibility-target": "input" } %>
                <button type="button"
                        data-action="password-visibility#toggle"
                        class="absolute inset-y-0 right-0 flex items-center pr-3 text-gray-500 hover:text-gray-700">
                  <span data-password-visibility-target="icon">
                    <!-- icono inicial (cerrado) -->
                    <svg class="w-6 h-6 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"> <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.933 13.909A4.357 4.357 0 0 1 3 12c0-1 4-6 9-6m7.6 3.8A5.068 5.068 0 0 1 21 12c0 1-3 6-9 6-.314 0-.62-.014-.918-.04M5 19 19 5m-4 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/> </svg>
                  </span>
                </button>
              </div>
            </div>
            </div>
            <% if devise_mapping.rememberable? %>
              <div class="flex items-center gap-2 pb-4">
                <%= f.check_box :remember_me, class: "rounded border-gray-300 text-main focus:ring-main" %>
                <%= f.label :remember_me, class: "text-sm text-success" %>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="mb-4 rounded-lg bg-warning/10 text-warning px-4 py-2">
                <%= flash[:alert] %>
              </div>
            <% end %>
            <%= f.submit "Iniciar sesión", class: "w-full bg-minor hover:bg-main/80 text-white font-semibold py-2 px-4 rounded-lg shadow transition cursor-pointer" %>
          </div> 
        <% end %>
      </div>
    </div>
  </div>
</main>
