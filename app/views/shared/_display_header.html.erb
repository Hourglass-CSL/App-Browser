<header>
  <nav
    class="
      bg-main w-full px-4 lg:px-20 py-4
      flex flex-col gap-4
      md:grid md:grid-cols-3 md:items-center
      relative
    "
  >
    <!-- Logo -->
    <div class="flex justify-center md:justify-start">
      <%= render "shared/logo" %>
    </div>

    <!-- Texto centrado REAL -->
    <div class="text-center">
      <h1 class="text-card_title text-xl md:text-4xl font-bold truncate">
        <%= t('nav.display_head') %>
      </h1>
      <p class="text-sm text-card_text">
        <%= t('nav.display_head_text') %>
      </p>
    </div>

    <!-- Idioma / Hora -->
    <div class="flex flex-col md:flex-row items-center justify-center md:justify-end gap-2 md:gap-6">
      <%= render "shared/time" %>
      <%= render "shared/language" %>
    </div>
  </nav>
</header>


<div id="mobile-lang-popup" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center">
  <div class="bg-black rounded-lg p-6 w-80 max-w-full text-center">
    <div class="flex justify-around">
      <svg class="w-8 h-8 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m13 19 3.5-9 3.5 9m-6.125-2h5.25M3 7h7m0 0h2m-2 0c0 1.63-.793 3.926-2.239 5.655M7.5 6.818V5m.261 7.655C6.79 13.82 5.521 14.725 4 15m3.761-2.345L5 10m2.761 2.655L10.2 15"/>
      </svg>  
    </div>

    <h2 class="text-sm text-white font-semibold"> Idioma / Language</h2>

    <div class="flex justify-around pt-8">
      <a href="/es" class="px-4 py-2 bg-button hover:bg-hover text-white rounded">Español</a>
      <a href="/en" class="px-4 py-2 bg-button hover:bg-hover text-white rounded">English</a>
    </div>
  </div>
</div>