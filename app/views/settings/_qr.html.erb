<div id="setting_qr" class="hidden md:block flex-1 min-h-0">
  <!-- TILE -->
  <div class="h-full flex items-center mx-auto content-center w-full gap-4 bg-dark_gray shadow-lg p-2 rounded-lg">
    <!-- QR  -->
    <div
      class="
        relative aspect-square h-full max-h-32
        bg-clear
        rounded-lg overflow-hidden
        shrink-0
      "
    >
      <% if setting.qr_code.attached? %>
        <%= image_tag setting.qr_code,
              class: "absolute inset-0 w-full h-full object-contain bg-white" %>
      <% else %>
        <div class="absolute inset-0 flex items-center justify-center">
          <svg class="w-full h-full max-h-32 aspect-square text-white"
               aria-hidden="true"
               xmlns="http://www.w3.org/2000/svg"
               fill="none"
               viewBox="0 0 24 24">
            <path stroke="currentColor" stroke-linejoin="round" stroke-width="1" d="M4 4h6v6H4V4Zm10 10h6v6h-6v-6Zm0-10h6v6h-6V4Zm-4 10h.01v.01H10V14Zm0 4h.01v.01H10V18Zm-3 2h.01v.01H7V20Zm0-4h.01v.01H7V16Zm-3 2h.01v.01H4V18Zm0-4h.01v.01H4V14Z"/>
            <path stroke="currentColor" stroke-linejoin="round" stroke-width="1" d="M7 7h.01v.01H7V7Zm10 10h.01v.01H17V17Z"/>
          </svg>
        </div>
      <% end %>
    </div>

    <!-- TEXT -->
    <span class="min-w-0">
      <h2 class="font-bold text-card_title text-2xl">
        <%= t("nav.qr_user_title") %>!
      </h2>

      <p class="text-card_text text-lg">
        <%= t("nav.qr_user_text") %>
      </p>
    </span>
  </div>
</div>
