<div id="setting_qr"
     class="hidden md:block flex-1 min-h-0 content-center bg-dark_gray shadow-lg p-2 rounded-lg text-center">
  <% if setting.qr_code.attached? %>
    <%= image_tag setting.qr_code,
          class: "mx-auto w-3/4  aspect-square object-contain bg-white p-4 rounded-lg "  %>

    <p class="text-card_text text-xl mt-4 font-bold"><%= t('nav.qr_user_title') %>!</p>
    <hr class="border-card_text mx-auto my-2" />
    <p class="text-card_text text-sm mt-2"><%= t('nav.qr_user_text') %></p>

  <% else %>
            <svg class="flex h-full max-h-32 aspect-square text-white mx-auto" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"  fill="none" viewBox="0 0 24 24">
              <path stroke="currentColor" stroke-linejoin="round" stroke-width="1" d="M4 4h6v6H4V4Zm10 10h6v6h-6v-6Zm0-10h6v6h-6V4Zm-4 10h.01v.01H10V14Zm0 4h.01v.01H10V18Zm-3 2h.01v.01H7V20Zm0-4h.01v.01H7V16Zm-3 2h.01v.01H4V18Zm0-4h.01v.01H4V14Z"/>
              <path stroke="currentColor" stroke-linejoin="round" stroke-width="1" d="M7 7h.01v.01H7V7Zm10 10h.01v.01H17V17Z"/>
            </svg>
        <% end %>
        
</div>

