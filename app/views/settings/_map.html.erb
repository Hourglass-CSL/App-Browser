<div data-controller="popup" id="map_setting_<%= setting.id %> " class="flex-1 min-h-0">
  <div id="setting_map" data-action="click->popup#open" class="h-full flex items-center mx-auto content-center w-full gap-4 bg-dark_gray shadow-lg p-2 rounded-lg cursor-pointer"> 
<button class="
  relative
  aspect-square
  h-full max-h-32
  bg-clear
  hover:bg-gray-200
  rounded-lg
  overflow-hidden
  cursor-pointer
">
  <%= image_tag 'map_icon.png',
      alt: 'Hotel Map',
      class: 'absolute inset-0 w-full h-full object-cover' %>
</button>
    <span>
      <h2 class="font-bold text-card_title "><%= t('nav.map') %></h2>
      <p class="text-card_text text-xs"><%= t('nav.map_user_text') %>.</p>
    </span>
  </div>

  <!-- Modal -->
  <div data-popup-target="dialog"
       data-action="click->popup#clickOutside"
       id="mapModal"
       class="hidden fixed top-0 left-0 right-0 z-50 w-full h-full overflow-x-hidden overflow-y-auto flex items-center justify-center bg-black/50">
    
    <div class="relative w-auto p-4 h-full md:h-auto">
      <div data-action="click->popup#preventClose" class="relative bg-dark_gray/90 rounded-lg shadow">

        <!-- Modal Header -->
        <div class="flex justify-between items-center p-5 rounded-t bg-minor/70">
          <h3 class="text-2xl font-bold text-card_title"><%= t('nav.map') %></h3>
          <button type="button" data-action="click->popup#close" class="text-white bg-transparent border border-white border-2 hover:bg-main hover:text-white hover:border-transparent rounded-xl text-sm p-1.5 ml-auto inline-flex items-center cursor-pointer">
                        <svg aria-hidden="true" class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            <span class="sr-only">Close popup</span>
          </button>
        </div>

        <!-- Modal Body -->
        <div class="p-6 flex justify-center items-center">
          <% if setting.map.attached? %>
            <%= image_tag setting.map, size: "900x600", class: "    rounded-lg shadow-lg" %>
          <% else %>
            <p class="text-white text-lg">No map uploaded.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
