<div data-controller="popup" id="map_setting_<%= setting.id %> " class="flex-1 min-h-0">
  <div id="setting_map" data-action="click->popup#open" class="h-full flex items-center mx-auto content-center w-full gap-4 bg-dark_gray shadow-lg p-2 rounded-lg cursor-pointer"> 
<button class="
  relative
  aspect-square
  h-full max-h-32
  bg-clear
  hover:bg-gray-200
  rounded-lg
  overflow-hidden
  cursor-pointer
">
  <%= image_tag 'map_icon.png',
      alt: 'Hotel Map',
      class: 'absolute inset-0 w-full h-full object-cover' %>
</button>
    <span>
      <h2 class="font-bold text-card_title "><%= t('nav.map') %></h2>
      <p class="text-card_text text-xs"><%= t('nav.map_user_text') %>.</p>
    </span>
  </div>

  <!-- Modal -->
<div
  data-popup-target="dialog"
  data-action="click->popup#clickOutside"
  id="mapModal"
  class="hidden fixed inset-0 z-50 bg-black/50 flex md:items-center md:justify-center p-0 md:p-4 overflow-hidden"
>
  <div
    data-action="click->popup#preventClose"
    class="w-full h-[100svh] max-w-7xl
           bg-dark_gray/90 rounded-none md:rounded-lg shadow
           flex flex-col overflow-hidden"
  >
    <!-- Header -->
    <div class="flex justify-between items-center p-4 bg-minor/70 flex-none">
      <h3 class="text-2xl font-bold text-card_title"><%= t('nav.map') %></h3>

      <button type="button" data-action="click->popup#close"
        class="text-white bg-transparent border-2 border-white hover:bg-main hover:border-transparent rounded-xl p-1.5 inline-flex items-center">
        <svg aria-hidden="true" class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>

    <!-- Body (sin padding y con alto real) -->
    <div class="flex-1 min-h-0 overflow-hidden px-2 rounded-lg ">
      <% if setting.map.attached? %>
        <%= image_tag setting.map, class: "w-full h-full object-contain rounded-lg " %>  
      <% else %>
        <div class="h-full w-full flex items-center justify-center">
          <p class="text-white text-lg">No map uploaded.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>



</div>
