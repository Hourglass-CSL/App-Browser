<div data-controller="popup" data-popup-menu-url-value="<%= menu_fetch_path(model: 'bar', id: bar.id, which: (I18n.locale == :es ? 'menu_file_es' : 'menu_file')) %>" id="<%= dom_id(bar) %>"  class="w-full flex flex-col " tabindex="0">
  <div  class="">

    <div data-action="click->popup#open" data-rotator-target="card" class="transition-opacity duration-500 cursor-pointer m-1">
      <%= render partial: "bars/bar", locals: { bar: bar } %>
    </div>


  <div
    data-popup-target="dialog"
    data-action="click->popup#clickOutside"
    id="popup-<%= bar.id %>"
    tabindex="-1"
    aria-hidden="true"
    class="hidden fixed top-0 left-0 right-0 z-50 w-full h-full overflow-x-hidden overflow-y-auto flex items-center justify-center bg-black/50"
    
  >
    <div class="relative w-auto p-4 h-full content-center">
      <div data-popup-target="panel" data-action="click->popup#preventClose" class="relative bg-dark_gray/80 rounded-lg shadow">

        <div class="flex justify-between items-center p-5 rounded-t bg-minor/70">
          <span class="flex items-center">
             <h3 class="text-2xl font-bold text-card_title uppercase"> <%= truncate(bar.bar_name, length: 32, separator: ' ') %></h3>
            <p class="text-card_text pl-4"><%= bar.open_time.strftime("%-I:%M%P") %> - <%= bar.closed_time.strftime("%-I:%M%P") %></p>
          </span>
          <button type="button" data-action="click->popup#close"
                  class="text-white bg-transparent border border-white border-2 hover:bg-main hover:text-white hover:border-transparent rounded-xl text-sm p-1.5 ml-auto inline-flex items-center cursor-pointer">
            <svg aria-hidden="true" class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            <span class="sr-only">Close popup</span>
          </button>
        </div>

        <!-- Contenido del menú se inyecta aquí al abrir -->
        <div class="p-6 space-y-4 flex flex-col justify-center content-center mx-auto">
<div data-popup-target="content" data-prerendered="true" class="w-auto max-h-screen overflow-auto rounded-lg">
  <% attachments = (I18n.locale == :es ? bar.menu_file_es : bar.menu_file) %>

  <% if attachments.attached? %>
    <div class="md:h-[900px] md:h-[750px] h-auto md:flex gap-3 md:space-y-0 space-y-2">
      <% attachments.each do |att| %>
        <% if att.blob.content_type&.start_with?("image/") %>
          <%= image_tag att, loading: "lazy", class: "w-full rounded-lg shadow" %>
        <% else %>
          <div class="p-3 bg-white/5 rounded-lg border border-white/10">
            <%= link_to att.filename.to_s, url_for(att), target: "_blank", rel: "noopener", class: "text-blue-400 underline" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <!-- Si no hay adjuntos aún, deja el placeholder (opcional) -->
    <div class="w-64 h-64 bg-gray-700/40 rounded animate-pulse" data-popup-placeholder></div>
  <% end %>
</div>

          <div class="flex items-center mx-auto content-center gap-4">
            <p class="text-xl text-card_text text-wrap md:text-center capitalize">
              <%= bar.bar_type.present? ? t("bar.bar_type.#{bar.bar_type}") : "" %>
            </p>
            <span class="flex w-2 h-2 me-2 bg-minor rounded-full"></span>
            <p class="text-xl text-card_text text-wrap md:text-center capitalize">
              <%= bar.dress_code.present? ? t("bar.dress_code.#{bar.dress_code}") : "" %>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>


  </div>
</div>