<div class="rounded-lg md:py-14 md:px-14 px-4 py-8 bg-white shadow-lg">      
  <%= form_with(model: @restaurant) do |form| %>
    <% if @restaurant.errors.any? %>
      <div class="mb-8 bg-warning/10 border border-warning text-warning px-4 py-3 rounded-lg">
        <h2 class="font-semibold"><%= t('warning_title') %></h2>
        <ul class="pt-4">
          <% @restaurant.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
  <% end %>
  
  
  <div class="flex grid md:grid-cols-3 grid-cols-1 gap-4">
    <div class=" ">
      <label for="restaurant_name" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span><%= t('field_3') %>:</label>
      <%= form.text_field :restaurant_name, maxlength: 32, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
    </div>
    <div>
      <label for="location" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span>Location:<p class="pl-2 text-minor">(English)</p></label>
      <%= form.text_field :location, maxlength: 32, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
    </div>
    <div>
      <label for="ubicacion" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span></span>Ubicación:<p class="pl-2 text-minor">(Español)</p></label>
      <%= form.text_field :ubicacion, maxlength: 32, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
    </div>
  </div>

  <div class="flex grid md:grid-cols-3 grid-cols-1 gap-4 pt-4">
    <div class="p-6 border-2 rounded-lg border-gray-200">
      <label class="block mb-2 text-sm font-medium text-gray-900 flex">
        <span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span>
        <%= t('nav.tab_day') %>:
      </label>
      <% days_en = Date::DAYNAMES.rotate # ["Monday", ..., "Sunday"] %>
      <% days_translated = I18n.t('date.day_names').rotate %>
      <% days = days_en.zip(days_translated) %>
      <%= form.collection_check_boxes :day_of_week, days, :first, :last do |b| %>
        <div class="flex items-center mb-2">
          <%= b.check_box(class: "w-4 h-4 text-main bg-gray-300 border-gray-300 rounded-lg focus:ring-minor focus:ring-2") %>
          <%= b.label(class: "ml-2 text-sm text-gray-900") %>
        </div>
      <% end %>
    </div>

    <div class="grid md:col-span-2 gap-4">
      <div class="grid md:grid-cols-2 grid-cols-1 gap-4 ">
        <div>
          <label for="open_time" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span><%= t('nav.tab_times_open') %>:</label>
            <div class="relative">
              <div class="absolute inset-y-0 end-0 top-0 flex items-center pe-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-gray-500  " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm11-4a1 1 0 1 0-2 0v4a1 1 0 0 0 .293.707l3 3a1 1 0 0 0 1.414-1.414L13 11.586V8Z" clip-rule="evenodd"/>
                </svg>
              </div>
                <%= form.text_field :open_time, type: "time", value: @restaurant.open_time&.strftime("%H:%M"), class: "bg-gray-50 w-full border leading-none border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5", required: true %>
            </div>
        </div>
        <div>
          <label for="closed_time" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span><%= t('nav.tab_times_close') %>:</label>
            <div class="relative">
              <div class="absolute inset-y-0 end-0 top-0 flex items-center pe-3.5 pointer-events-none">
                <svg class="w-4 h-4 text-gray-500  " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm11-4a1 1 0 1 0-2 0v4a1 1 0 0 0 .293.707l3 3a1 1 0 0 0 1.414-1.414L13 11.586V8Z" clip-rule="evenodd"/>
                </svg>
              </div>
              <%= form.text_field :closed_time, type: "time", value: @restaurant.closed_time&.strftime("%H:%M"), class: "bg-gray-50 w-full border leading-none border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5", required: true %>
            </div>
        </div>
        <div>
          <label for="meal_plan" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span>Meal Plan:</label>
            <%= form.select :meal_plan,
      options_for_select(
        [
          [t('restaurant.meal_plan.breakfast'), "breakfast"],
          [t('restaurant.meal_plan.brunch'),    "brunch"],
          [t('restaurant.meal_plan.lunch'),     "lunch"],
          [t('restaurant.meal_plan.dinner'),    "dinner"]
        ],
        @restaurant.meal_plan
      ),
          { include_blank: t('helpers.select.meal_plan') },
        class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5" %>
        </div>
        <div>
          <label for="restaurant_type" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span><%= t('nav.menu') %>:</label>
          <%= form.select :restaurant_type,
            [
              [t('restaurant.restaurant_type.a_la_carte'), "a_la_carte"],
              [t('restaurant.restaurant_type.buffete'), "buffete"],
              [t('restaurant.restaurant_type.beverages'), "beverages"],
              [t('restaurant.restaurant_type.childrens'), "childrens"],
              [t('restaurant.restaurant_type.daily'), "daily"],
              [t('restaurant.restaurant_type.snacks'), "snacks"],
              [t('restaurant.restaurant_type.tasting'), "tasting"]
            ],
            { include_blank: t('helpers.select.menu') },
            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5" %>
        </div>
        <div>
          <label for="cuisine_type" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span><%= t('nav.cuisine') %>:</label>
            <%= form.select :cuisine_type,
              [
                [t('restaurant.cuisine_type.american'), "american"],
                [t('restaurant.cuisine_type.french'), "french"],
                [t('restaurant.cuisine_type.indian'), "indian"],
                [t('restaurant.cuisine_type.international'), "international"],
                [t('restaurant.cuisine_type.italian'), "italian"],
                [t('restaurant.cuisine_type.japanese'), "japanese"],
                [t('restaurant.cuisine_type.mediterranean'), "mediterranean"],
                [t('restaurant.cuisine_type.mexican'), "mexican"],
                [t('restaurant.cuisine_type.sushi'), "sushi"],
                [t('restaurant.cuisine_type.seafood'), "seafood"],
                [t('restaurant.cuisine_type.steak'), "steakhouse"],
                [t('restaurant.cuisine_type.tapas'), "tapas"],
                [t('restaurant.cuisine_type.thai'), "thai"]
               ],
               { include_blank: t('helpers.select.cuisine') },
               class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5" %>
        </div>
        <div class="mb-4">
          <label for="dress_code" class="block mb-2 text-sm font-medium text-gray-900 flex"><%= t('nav.dress') %>:</label>
            <%= form.select :dress_code,
            [
              [t('restaurant.dress_code.casual'), "casual"],
              [t('restaurant.dress_code.elegant'), "elegant"],
              [t('restaurant.dress_code.formal'), "formal"],
              [t('restaurant.dress_code.smart_casual'), "smart_casual"],
              [t('restaurant.dress_code.business'), "business"],
              [t('restaurant.dress_code.jacket'), "jacket"],
              [t('restaurant.dress_code.resort'), "resort"],
              [t('restaurant.dress_code.swimwear'), "swimwear"],
              [t('restaurant.dress_code.no_dress_code'), "no_dress_code"]
             ],
            { include_blank: t('helpers.select.dress') },
            class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5" %>
        </div>

      </div>
    </div>

    <div class="mb-4">
        <%= form.label :logo, class: "block mb-2 text-sm font-medium text-gray-900 flex items-center" do %>
          <span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span>
          <span>Logo:</span>
        <% end %>
        <button type="button" class="show-stock-gallery block text-sm rounded-lg cursor-pointer bg-gray-800 hover:bg-gray-600 focus:outline-none text-white font-semibold px-4 py-2" data-field="logo" data-folder="hourglass_app_20/GFALC/logos/"><%= t('buttons.select')%></button>
        <div id="selected-logo-filename" class="mt-2 text-xs text-gray-700"></div>
          <%= hidden_field_tag :stock_image_key_logo, nil, id: "stock-image-key-logo" %>
        <div id="stock-gallery-logo" class="hidden w-full pt-4"></div>

        <% if form.object.persisted? && form.object.logo.attached? %>
          <div class="mt-2">
            <strong>Logo:</strong><br>
            <%= image_tag url_for(@restaurant.logo), alt: "Logo", class: "h-24 w-auto mb-2" %>
          </div>
        <% end %>
    </div>

    <div class="mb-4">
      <%= form.label :menu_file, class: "block mb-2 text-sm font-medium text-gray-900 flex" do %>
        Menu: <p class="pl-2 text-minor">(English)</p>
      <% end %>
      <button type="button" class="show-stock-gallery block text-sm rounded-lg cursor-pointer bg-gray-800 hover:bg-gray-600 focus:outline-none text-white font-semibold px-4 py-2" data-field="menu_file" data-folder="hourglass_app_20/GFALC/menus/">
        <%= t('buttons.select')%>
      </button>
      <div id="selected-menu_file-filename" class="mt-2 text-xs text-gray-700"></div>
        <%= hidden_field_tag :stock_image_key_menu_file, nil, id: "stock-image-key-menu_file" %>
          <div id="stock-gallery-menu_file" class="hidden"></div>

          <% if form.object.persisted? && form.object.menu_file.attached? %>
            <div class="mt-2 text-xs text-gray-700">
              <span class="font-semibold block mb-1">Seleccionado:</span>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% form.object.menu_file.each do |att| %>
                    <div class="inline-flex items-center gap-2 px-2 py-1 bg-gray-100 rounded">
                      <%= link_to att.filename, url_for(att), target: "_blank", class: "text-blue-600 underline" %>
                        <%= link_to purge_menu_file_restaurant_path(form.object, attachment_id: att.id),
                                    data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este archivo?" },
                                    class: "text-warning hover:text-red-700 inline-flex items-center justify-center" do %>
                          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                            <path fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm5.757-1a1 1 0 1 0 0 2h8.486a1 1 0 1 0 0-2H7.757Z" clip-rule="evenodd"/>
                          </svg>
                        <% end %>
                    </div>
                  <% end %>
              </div>
             </div>
          <% end %>
    </div>

    <div class="mb-4">
      <%= form.label :menu_file_es, for: "file_input", class: "block mb-2 text-sm font-medium text-gray-900 flex" do %>
        Menu: <p class="pl-2 text-minor">(Español)</p>
      <% end %>
      <button type="button" class="show-stock-gallery block text-sm rounded-lg cursor-pointer bg-gray-800 hover:bg-gray-600 focus:outline-none text-white font-semibold px-4 py-2" data-field="menu_file_es" data-folder="hourglass_app_20/GFALC/menus/">
        <%= t('buttons.select')%>
      </button>
      <div id="selected-menu_file_es-filename" class="mt-2 text-xs text-gray-700"></div>
        <%= hidden_field_tag :stock_image_key_menu_file_es, nil, id: "stock-image-key-menu_file_es" %>
          <div id="stock-gallery-menu_file_es" class="hidden"></div>
            <% if form.object.persisted? && form.object.menu_file_es.attached? %>
              <div class="mt-2 text-xs text-gray-700">
                <span class="font-semibold block mb-1">Seleccionado:</span>
                <div class="mt-2 flex flex-wrap gap-2">
                  <% form.object.menu_file_es.each do |att| %>
                    <div class="inline-flex items-center gap-2 px-2 py-1 bg-gray-100 rounded">
              <%= link_to att.filename, url_for(att), target: "_blank", class: "text-blue-600 underline" %>
              <%= link_to purge_menu_file_es_restaurant_path(form.object, attachment_id: att.id),
                          data: { turbo_method: :delete, turbo_confirm: "¿Eliminar este archivo?" },
                          class: "text-red-600 hover:text-red-700 inline-flex items-center justify-center" do %>
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg"
                    fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd"
                        d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm5.757-1a1 1 0 1 0 0 2h8.486a1 1 0 1 0 0-2H7.757Z"
                        clip-rule="evenodd"/>
                </svg>
              <% end %>
            </div>
          <% end %>
      </div>
    </div>
    <% end %>
  </div>

</div>

  <div class="mt-6">
      <%= form.submit t('buttons.save'), class: "px-4 py-2 bg-minor text-white rounded hover:bg-main cursor-pointer" %>
      <%= link_to_with_locale t('buttons.cancel'), restaurants_path, class: "px-4 py-2 text-ds-text rounded hover:bg-clear hover:text-ds-subtitle" %>
  </div>

<% end %>
  <div class="flex items-center justify-end">
   <span class="flex w-3 h-3 me-3 bg-warning rounded-full"></span>
    <p class="text-ds-text"><%= t('field_mandatory') %>.</p>
  </div>
</div>