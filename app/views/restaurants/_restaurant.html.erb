<div id="rest_cards" class="flex flex-wrap  rounded-lg shadow-lg  ">
  <div class="flex items-center w-full rounded-lg space-x-4 bg-dark_gray shrink ">

      <div class="rounded-l-lg content-center md:p-3 p-4  ">

      <% if restaurant.logo.attached? %>
       <%= image_tag  restaurant.logo, class: "h-18 w-18 rounded object-contain" %>
  
      <% else %>
        <div class="h-20 w-20 rounded bg-gray-700 animate-pulse"></div>
      <% end %>

   
      </div>
    
      <div class="">
        <p class="text-lg text-card_title truncate uppercase"><%= truncate( restaurant.restaurant_name, length: 18) %></p>
        <p class="text-sm text-card_text flex  items-center truncate capitalize"><%= inline_svg_tag "restaurant_icon.svg", class: "h-3 w-3" %> &nbsp;<%= t("restaurant.restaurant_type.#{restaurant.restaurant_type}") %></p>
        <p class="text-sm text-card_text flex items-center capitalize truncate"><%= inline_svg_tag "food_icon.svg", class: "h-3 w-3" %> &nbsp;<%= t("restaurant.cuisine_type.#{restaurant.cuisine_type}") %></p>
          <span class="text-sm text-card_text flex items-center capitalize">
            <svg class="w-3 h-3 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M11.906 1.994a8.002 8.002 0 0 1 8.09 8.421 7.996 7.996 0 0 1-1.297 3.957.996.996 0 0 1-.133.204l-.108.129c-.178.243-.37.477-.573.699l-5.112 6.224a1 1 0 0 1-1.545 0L5.982 15.26l-.002-.002a18.146 18.146 0 0 1-.309-.38l-.133-.163a.999.999 0 0 1-.13-.202 7.995 7.995 0 0 1 6.498-12.518ZM15 9.997a3 3 0 1 1-5.999 0 3 3 0 0 1 5.999 0Z" clip-rule="evenodd"/>
            </svg>
        <p class="truncate pl-1 text-card_text capitalize truncate"><%= restaurant.send(I18n.locale == :es ? :ubicacion : :location) %></p> 
        </span>
      </div>

      <div class="flex items-center text-xs md:text-base rounded-r-lg h-full mx-auto">
        <p class="text-card_text capitalize"><%= restaurant.open_time.strftime("%-I:%M%P") %> - <%= restaurant.closed_time.strftime("%-I:%M%P") %></p>
      </div>

  </div>
</div>
 


 

 