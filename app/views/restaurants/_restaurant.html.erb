<div id="rest_cards" class="w-full">
  <div class="w-full rounded-lg shadow-lg bg-dark_gray overflow-hidden">
    <div class="flex items-center gap-4 px-4 py-2">

      <!-- LOGO  -->
      <div class="flex-shrink-0">
        <% if restaurant.logo.attached? %>
          <%= image_tag restaurant.logo,
                class: "w-16 h-16 rounded-lg object-contain bg-black/10 p-1" %>
        <% else %>
          <div class="w-16 h-16 rounded-lg bg-gray-700 animate-pulse"></div>
        <% end %>
      </div>

      <!-- INFO  -->
      <div class="flex-1 min-w-0">
        <p class="text-card_title uppercase truncate">
          <%= truncate(restaurant.restaurant_name, length: 18) %>
        </p>
        

        <div class="mt-1 flex flex-col gap-1">
          <p class="text-sm text-card_text flex items-center gap-1 capitalize truncate">
            <%= inline_svg_tag "food_icon.svg", class: "h-3 w-3 flex-shrink-0" %>
            <span class="truncate"><%= t("restaurant.cuisine_type.#{restaurant.cuisine_type}") %></span>
          </p>

          

          <div class="text-sm text-card_text flex items-center gap-1 min-w-0">
            <svg class="w-3 h-3 flex-shrink-0 text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M11.906 1.994a8.002 8.002 0 0 1 8.09 8.421 7.996 7.996 0 0 1-1.297 3.957.996.996 0 0 1-.133.204l-.108.129c-.178.243-.37.477-.573.699l-5.112 6.224a1 1 0 0 1-1.545 0L5.982 15.26l-.002-.002a18.146 18.146 0 0 1-.309-.38l-.133-.163a.999.999 0 0 1-.13-.202 7.995 7.995 0 0 1 6.498-12.518ZM15 9.997a3 3 0 1 1-5.999 0 3 3 0 0 1 5.999 0Z" clip-rule="evenodd"/>
            </svg>

            <p class="truncate normal-case">
              <%= restaurant.send(I18n.locale == :es ? :ubicacion : :location) %>
            </p>
          </div>
        </div>
      </div>

      <!-- OPEN TIME -->
      <div class="flex flex-col text-center">

      <p class="text-card_text text-xs leading-tight">
          <%= restaurant.open_time.strftime("%-I:%M%P") %>
      </p>
      <span class="opacity-70 text-white">-</span>

      <p class="text-card_text text-xs  leading-tight">
          <%= restaurant.closed_time.strftime("%-I:%M%P") %>
      </p>

      </div>

    </div>
  </div>
</div>
