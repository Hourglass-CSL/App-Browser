<div data-controller="popup" data-popup-menu-url-value="<%= menu_fetch_path(model: 'restaurant', id: restaurant.id, which: (I18n.locale == :es ? 'menu_file_es' : 'menu_file')) %>" id="<%= dom_id(restaurant) %>" class="flex flex-col w-full" tabindex="0">

  <div data-action="click->popup#open">
    <div data-rotator-target="card" id="card-<%= dom_id(restaurant) %>" class="transition-opacity duration-500 cursor-pointer mt-1 ">
      <%= render partial: "restaurants/restaurant", locals: { restaurant: restaurant } %>
    </div>
  </div>

 <% attachments = (I18n.locale == :es ? restaurant.menu_file_es : restaurant.menu_file) %>

<% if attachments.attached? %>
  <div data-popup-target="dialog" data-action="click->popup#clickOutside" id="popup-<%= restaurant.id %>" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 left-0 right-0 z-50 w-full h-full overflow-x-hidden overflow-y-auto flex items-center justify-center bg-black/50">
  
  <div class="relative w-auto p-4 h-full  content-center">
      <div data-popup-target="panel" data-action="click->popup#preventClose" class="relative bg-dark_gray/80 rounded-lg shadow">
        <!-- HEADER  -->
        <div class="flex justify-between items-center p-5 rounded-t bg-minor/70">
          <span class="flex items-center">
            <h3 class="text-2xl font-bold text-card_title uppercase">
              <%= truncate(restaurant.restaurant_name, length: 32, separator: ' ') %>
            </h3>
            <p class="text-card_text pl-4">
              <%= restaurant.open_time.strftime("%-I:%M%P") %> - <%= restaurant.closed_time.strftime("%-I:%M%P") %>
            </p>
          </span>
          <button type="button" data-action="click->popup#close"
            class="text-white bg-transparent border border-white border-2 hover:bg-main hover:text-white hover:border-transparent rounded-xl text-sm p-1.5 ml-auto inline-flex items-center cursor-pointer">
            <svg aria-hidden="true" class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            <span class="sr-only">Close popup</span>
          </button>
        </div>

        <!-- BODY -->
        <div class="p-6 space-y-4 flex flex-col justify-center content-center mx-auto">
          <div data-popup-target="content" data-prerendered="true" class="w-auto max-h-full overflow-auto rounded-lg">

            <div class="md:w-full md:max-h-[70vh] h-auto md:flex gap-3 md:space-y-0 space-y-2">
              <% attachments.each do |att| %>
                <% if att.blob.content_type&.start_with?("image/") %>
                  <%= image_tag att, class: "w-full rounded-lg shadow" %>
                <% else %>
                  <div class="p-3 bg-white/5 rounded-lg border border-white/10">
                    <%= link_to att.filename.to_s, url_for(att), target: "_blank", rel: "noopener", class: "text-blue-400 underline" %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="flex items-center mx-auto content-center gap-4">
            <p class="text-xl text-white text-wrap md:text-center">
              <%= t("restaurant.restaurant_type.#{restaurant.restaurant_type}") %>
            </p>
            <span class="flex w-2 h-2 me-2 bg-minor rounded-full"></span>
            <p class="text-xl text-white text-wrap md:text-center">
              <%= t("restaurant.cuisine_type.#{restaurant.cuisine_type}") %>
            </p>
            <span class="flex w-2 h-2 me-2 bg-minor rounded-full"></span>
            <p class="text-xl text-white text-wrap md:text-center">
              <%= restaurant.dress_code.present? ? t("restaurant.dress_code.#{restaurant.dress_code}") : "" %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
</div>
