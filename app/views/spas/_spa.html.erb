<div data-controller="popup"
     id="spa_setting_<%= spa&.id || "none" %>"
     class="flex-1 min-h-0">

  <!-- TILE -->
  <div id="setting_spa_menu"
       data-action="click->popup#open"
       class="h-full flex items-center mx-auto content-center w-full gap-4 bg-dark_gray shadow-lg p-2 rounded-lg cursor-pointer">

    <button class="relative aspect-square h-full max-h-32 bg-clear hover:bg-gray-200 rounded-lg overflow-hidden cursor-pointer">
      <%= image_tag 'spa_icon.png',
            alt: 'Spa Menu',
            class: 'absolute inset-0' %>
    </button>

    <span>
      <h2 class="font-bold text-card_title"><%= t('nav.module_title_6') %></h2>
      <p class="text-card_text text-xs"><%= t('nav.spa_user_text') %>.</p>
    </span>
  </div>

  <!-- MODAL -->
  <div data-popup-target="dialog"
       data-action="click->popup#clickOutside"
       id="spaMenuModal"
       class="hidden fixed top-0 left-0 right-0 z-50 w-full h-full overflow-x-hidden overflow-y-auto flex items-center justify-center bg-black/50">

    <div class="relative w-auto p-4 h-full md:h-auto">
      <div data-action="click->popup#preventClose"
           class="relative bg-dark_gray/90 rounded-lg shadow">

        <!-- HEADER -->
        <div class="flex justify-between items-center p-5 rounded-t bg-minor/70 shrink-0">
          <h3 class="text-2xl font-bold text-card_title">
            <%= t('nav.module_title_6') %>
          </h3>

          <button type="button"
                  data-action="click->popup#close"
                  class="text-white bg-transparent border border-white border-2 hover:bg-main hover:text-white hover:border-transparent rounded-xl text-sm p-1.5 ml-auto inline-flex items-center cursor-pointer">
            <svg aria-hidden="true" class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd"
                    d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                    clip-rule="evenodd" />
            </svg>
            <span class="sr-only">Close popup</span>
          </button>
        </div>

        <!-- BODY -->
        <div class="p-6 overflow-y-auto flex-1">
          <% if spa.present? %>
            <% files = spa.menu_files_for(I18n.locale) %>

            <% if files.present? %>
              <div class="w-auto max-h-screen overflow-auto rounded-lg">
                <div class="md:h-[750px] max-h-[70dvh] h-auto md:flex gap-3 md:space-y-0 space-y-2">
                  <% files.each do |att| %>
                    <% if att.blob.content_type&.start_with?("image/") %>
                      <%= image_tag att,
                            loading: "lazy",
                            class: "w-full rounded-lg shadow" %>
                    <% else %>
                      <div class="p-3 bg-white/5 rounded-lg border border-white/10">
                        <%= link_to att.filename.to_s,
                              url_for(att),
                              target: "_blank",
                              rel: "noopener",
                              class: "text-blue-400 underline" %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% else %>
              <p class="text-white text-lg">
                <%= t("nav.no_menu_text") %>
              </p>
            <% end %>

          <% else %>
            <p class="text-white text-lg">
             <%= t("nav.no_menu_text") %>
            </p>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>
