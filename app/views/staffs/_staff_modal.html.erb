<div
  id="popup-<%= staff.id %>"
  data-staff-popup-target="dialog"
  data-action="click->staff-popup#clickOutside"
  tabindex="-1"
  aria-hidden="true"
  class="hidden fixed inset-0 z-[999] items-center justify-center bg-black/50 p-4"
>
  <div
    data-action="click->staff-popup#preventClose"
    class="relative w-full max-w-xl bg-dark_gray/80 rounded-lg shadow overflow-hidden max-h-[90svh] md:max-h-[90vh] flex flex-col"
  >
    <!-- Header -->
    <div class="flex justify-between items-center p-5 bg-minor/70 flex-none">
      <h3 class="text-lg sm:text-2xl font-bold text-card_title uppercase">
        <%= truncate(staff.name, length: 32, separator: ' ') %>
      </h3>

      <button
        type="button"
        data-action="click->staff-popup#close"
        class="text-white bg-transparent border border-white border-2 hover:bg-main hover:text-white hover:border-transparent rounded-xl text-sm p-1.5 ml-auto inline-flex items-center cursor-pointer"
      >
        <svg aria-hidden="true" class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        <span class="sr-only">Close popup</span>
      </button>
    </div>

    <!-- Content -->
    <div class="flex-auto overflow-y-auto p-4 sm:p-6 space-y-4">
      <% if staff.profile_picture.attached? %>
        <div class="w-full overflow-hidden rounded-lg">
          <%= image_tag staff.profile_picture, class: "w-full max-h-[50svh] md:max-h-[70vh] object-contain mx-auto" %>
        </div>
      <% end %>

      <p class="text-base sm:text-xl text-card_text md:text-center whitespace-normal break-words hyphens-auto capitalize">
        <%= truncate((staff.send(I18n.locale == :es ? :descripcion : :bio).presence || t('hello')), length: 120, separator: ' ') %>
      </p>
    </div>
  </div>
</div>