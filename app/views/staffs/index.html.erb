<div class="antialiased bg-gray-50 h-full">
<%= render "shared/dashboard_header" %> 
 <div id="flash-container">
  <%= render "shared/flash" %>
  </div>
  <main class="p-4 md:ml-64 pt-20">  
    <section class="flex md:flex-row flex-col mx-auto content-center items-center justify-between px-8 pb-4 md:space-y-0 space-y-8">
        <h1 class="md:text-2xl text-xl uppercase text-minor  font-bold"><%= t('nav.module_member') %></h1>
          <div class=" ">
            <% unless current_user.reader? %> <%= link_to t('nav.new_staff'), new_staff_path(locale: I18n.locale), class: "px-4 py-2 bg-minor text-white rounded hover:bg-main" %> <% end %>
          </div>  
    </section>

    <section class="pt-4 mb-4">
      <div class="overflow-x-auto shadow-lg">
        <table class="w-full divide-y divide-gray-200">
          <thead class="bg-main/10 font-bold sticky top-0 ">
            <tr>
              <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase"><%= t('nav.tab_name') %></th>
              <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase"><%= t('nav.tab_role') %></th>
              <th class="px-6 py-3 text-left text-xs text-ds-subtitle uppercase">Bio <%= t('nav.tab_description') %> </th>
              <% unless current_user.reader? %> <th class="px-6 py-3"></th> <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @staffs.each do |staff| %>
              <tr id="<%= dom_id(staff) %>">
                <td class="px-6 py-4 capitalize hover:text-minor"><%= link_to staff.name, staff_path(staff) %>  </td>
                <td class="ppx-6 py-4 capitalize"><%= staff.position %> / <%= staff.puesto %></td>
                <td class="px-6 py-4 capitalize flex-col"><p><%= truncate(staff.bio, length: 20) %></p> <p><%= truncate(staff.descripcion, length: 20) %></p></td>

                <% unless current_user.reader? %> <td class="px-6 py-4">
                  <span class="flex items-center space-x-4">
                    <%= link_to edit_staff_path(staff), title: "Edit Staff" do %>
                          <svg class="w-6 h-6 text-gray-400 hover:text-success" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/>
                          </svg>
                    <% end %>
                    <%= button_to staff_path(staff),
                          method: :delete,
                          data: { turbo_confirm: "Really delete this activity?" },
                          class: "inline-flex items-center px-2 py-1 text-warning hover:text-red-500 rounded-sm cursor-pointer" do %>
                            <svg class="w-6 h-6 text-gray-400 hover:text-warning" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/>
                            </svg>
                    <% end %>
                    </span>
                </td> <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</div>