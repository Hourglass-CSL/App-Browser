<div class="antialiased bg-gray-50 h-full">
  <%= render "shared/dashboard_header" %> 
  <%= render "shared/flash" %>
  <main class=" p-4 md:ml-64 pt-20">

    <div class="container mx-auto content-center">

        <section class="flex md:flex-row flex-col mx-auto content-center items-center justify-between px-8 pb-4 md:space-y-0 space-y-8">
        <h1 class="md:text-2xl text-xl uppercase text-minor font-bold"><%= @staff.name %></h1>
      </section>

      <section class="flex justify-center md:justify-start rounded-lg md:py-14 md:px-14 px-4 py-8 shadow-lg bg-white">
        <div class="mb-4 space-y-2 md:flex items-center">
          <div>
            <% if @staff.profile_picture.attached? %>
              <%= image_tag @staff.profile_picture, size: "100x200" %>
            <% else %>
              <p class="text-gray-500"><strong>No image uploaded</strong></p>
            <% end %>
          </div>
          <div class="pl-8 md:pt-0 pt-4 content-center text-lg space-y-2 md:text-left text-center">
            <p><strong class=" ">Position:</strong> <%= @staff.position %> / <%= @staff.puesto %></p>
            <p class=" "><strong>Bio <%= t('nav.tab_description') %>:</strong></p>

            <p class="whitespace-pre-line"><span class="text-minor font-medium">English:</span> <%= @staff.bio|| "---" %></p>
            <p class="whitespace-pre-line"><span class="text-minor font-medium">Español:</span> <%= @staff.descripcion.presence || "---" %></p>
       
          </div>
        </div>
      </section>

      <% unless current_user.reader? %> 
      <section class="flex md:justify-start justify-center pt-8 space-x-2">
          <%= link_to "Edit", edit_staff_path(@staff),
                class: "px-4 py-2 bg-minor text-white rounded hover:bg-main" %>
          <%= link_to "Back to List", staffs_path,
                class: "px-4 py-2 text-ds-text rounded hover:bg-clear hover:text-ds-subtitle" %>
      </section>
      <% end %>

    </div>
  </main>
</div>




 