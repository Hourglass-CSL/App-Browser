<div
  id="staff-carousel"
  class="relative w-full py-2"
  data-controller="flowbite-carousel"
  data-carousel="slide"
>
  <!-- Carousel wrapper -->
  <div class="relative h-[560px] md:h-[700px] overflow-hidden rounded-lg">
    <% staff_members.each_with_index do |staff, index| %>
      <div
        class="<%= index.zero? ? '' : 'hidden' %> duration-700 ease-in-out h-full"
        data-carousel-item="<%= 'active' if index.zero? %>"
      >
        <div class="h-full w-full">
          <%= render "staffs/staff_card", staff: staff %>
        </div>
      </div>
    <% end %>
  </div>

  <% if staff_members.size > 1 %>
    <!-- Indicators -->
    <div class="absolute z-30 flex -translate-x-1/2 bottom-5 left-1/2 space-x-3">
      <% staff_members.each_with_index do |staff, index| %>
        <button
          type="button"
          class="w-3 h-3 rounded-full bg-white/50"
          aria-label="Slide <%= index + 1 %>"
          data-carousel-slide-to="<%= index %>"
        ></button>
      <% end %>
    </div>

    <!-- Prev -->
    <button
      type="button"
      class="absolute top-0 left-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
      data-carousel-prev
    >
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 group-hover:bg-white/50">
        <svg class="w-5 h-5 text-white" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/>
        </svg>
        <span class="sr-only">Previous</span>
      </span>
    </button>

    <!-- Next -->
    <button
      type="button"
      class="absolute top-0 right-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
      data-carousel-next
    >
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 group-hover:bg-white/50">
        <svg class="w-5 h-5 text-white" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/>
        </svg>
        <span class="sr-only">Next</span>
      </span>
    </button>
  <% end %>
</div>

<!-- Los modales viven fuera del carrusel -->
<div id="staff-modals">
  <% staff_members.each do |staff| %>
    <%= render "staffs/staff_modal", staff: staff %>
  <% end %>
</div>