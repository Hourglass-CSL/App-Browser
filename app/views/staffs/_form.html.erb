<div class="rounded-lg md:py-14 md:px-14 px-4 py-8 bg-white shadow-lg">     
  <%= form_with(model: staff) do |form| %>
    <% if staff.errors.any? %>
      <div class="mb-8 bg-warning/10 border border-warning text-warning px-4 py-3 rounded-lg">
        <h2 class="font-semibold"><%= t('warning_title') %></h2>
        <ul class="pt-4">
          <% staff.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

  <div class="mb-4">
    <label for="name" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span><%= t('field_5') %>:</label>
    <%= form.text_field :name, maxlength: 32, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
  </div>
<div class="flex grid md:grid-cols-2 grid-cols-1 gap-4 mb-4">
  <div class="mb-4 ">
    <label for="position" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span>Role: <p class="pl-2 text-minor">(English)</p></label>
    <%= form.text_field :position, maxlength: 32, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
  </div>

    <div class="mb-4 ">
    <label for="puesto" class="block mb-2 text-sm font-medium text-gray-900 flex"><span class="flex w-2 h-2 me-3 bg-warning rounded-full"></span>Puesto: <p class="pl-2 text-minor">(Español)</p></label>
    <%= form.text_field :puesto, maxlength: 32, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
  </div>

    <div class="mb-4">
    <label for="bio" class="block mb-2 text-sm font-medium text-gray-900 flex">About Me: <p class="pl-2 text-minor">(English)</p></label>
    <%= form.text_area :bio, maxlength: 120, rows: 5, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
  </div>

  <div class="mb-4">
    <label for="descripcion" class="block mb-2 text-sm font-medium text-gray-900 flex">Acerca de Mí: <p class="pl-2 text-minor">(Español)</p></label>
    <%= form.text_area :descripcion, maxlength: 120, rows: 5, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" %>
  </div>

  </div>

  <!-- ADD profile_picture UPLOAD HERE -->
  <div class="mb-4">
    <%= form.label :profile_picture, t('nav.tab_pic'), class: "block mb-2 text-sm font-medium text-gray-900 flex" %>
      <button type="button" class="show-stock-gallery block text-sm rounded-lg cursor-pointer bg-gray-800 hover:bg-gray-600 focus:outline-none text-white font-semibold px-4 py-2" data-field="profile_picture" data-folder="hourglass_app_20/GFALC/staff/"><%= t('buttons.select')%></button>
        <div id="selected-profile_picture-filename" class="mt-2 text-xs text-gray-700"></div>
          <%= hidden_field_tag :stock_image_key_profile_picture, nil, id: "stock-image-key-profile_picture" %>
            <div id="stock-gallery-profile_picture" class="hidden pt-4"></div>


   <% if form.object.persisted? && form.object.profile_picture.attached? %>
      <div class="mt-2">
        <span class="text-xs text-gray-500"> </span><br>
        <%= image_tag @staff.profile_picture, size: "100x100", class: "rounded" %>
      </div>
    <% end %>
  </div>



  <div class="mt-6">
      <%= form.submit t('buttons.save'), class: "px-4 py-2 bg-minor text-white rounded hover:bg-main cursor-pointer" %>
      <%= link_to_with_locale t('buttons.cancel'), staffs_path, class: "px-4 py-2 text-ds-text rounded hover:bg-clear hover:text-ds-subtitle" %>
  </div>
<% end %>
  <div class="flex items-center justify-end">
   <span class="flex w-3 h-3 me-3 bg-warning rounded-full"></span>
    <p class="text-ds-text"><%= t('field_mandatory') %>.</p>
  </div>
</div>