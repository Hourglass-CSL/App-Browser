<div class="antialiased bg-gray-50 h-full">
  <%= render "shared/dashboard_header" %> 
 
  <main class="p-4 md:ml-64 pt-20">
    <div class="container mx-auto content-center">
      <section class="flex md:flex-row flex-col mx-auto content-center items-center justify-between px-8 pb-4 md:space-y-0 space-y-8">
        <h1 class="md:text-2xl text-xl uppercase text-minor  font-bold"><%= @activity.title %> / <%= @activity.nombre %></h1>
      </section>

      <section class="flex justify-center md:justify-start rounded-lg md:py-14 md:px-14 px-4 py-8 shadow-lg bg-white">
        <div class="mb-4 space-y-2 md:flex items-center">
          <div>
          <% if @activity.cover_image.attached? %>
            <div> 
          <%= image_tag @activity.cover_image, size: "100x200" %>
            </div>
          <% end %>
          </div>
          <div class="pl-8 md:pt-0 pt-4 content-center text-lg space-y-2 md:text-left text-center">
            <p><strong><%= t('nav.tab_location') %>:</strong> <%= @activity.location %> / <%= @activity.ubicacion %></p>
            <p><strong><%= t('nav.tab_day') %>:</strong> <%= @activity.day_of_week.reject(&:blank?).map { |day| I18n.t("date.day_names")[Date::DAYNAMES.index(day)] }.join(", ") %></p>
            <p><strong><%= t('nav.tab_times_open') %>:</strong> <%= @activity.open_time.strftime("%I:%M %p") %></p>
            <p><strong><%= t('nav.tab_times_close') %>:</strong> <%= @activity.closed_time.strftime("%I:%M %p") %></p>
            <p><strong><%= t('nav.tab_description') %>:</strong></p>
            <p class="whitespace-pre-line"><span class="text-minor font-medium">English:</span> <%= @activity.description.presence || "---" %></p>
            <p class="whitespace-pre-line"><span class="text-minor font-medium">Español:</span> <%= @activity.descripcion.presence || "---" %></p>
            
          </div>
        </div>
      </section>

      <% unless current_user.reader? %> 
      <section class="flex md:justify-start justify-center pt-8 space-x-2">
          <%= link_to_with_locale t('buttons.edit'), edit_activity_path(@activity), class: "px-4 py-2 bg-minor text-white rounded hover:bg-main" %>
          <%= link_to_with_locale t('buttons.back'), activities_path, class: "px-4 py-2 text-ds-text rounded hover:bg-clear hover:text-ds-subtitle" %>
        </div>
      </section>
      <% end %>

    </div>
  </main>
</div>